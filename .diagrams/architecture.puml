@startuml SmartFinance Architecture (FINA Branch)

skinparam component {
  BackgroundColor #FAFAFA
  BorderColor #37474F
}
skinparam node {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
}
skinparam database {
  BackgroundColor #FFFDE7
  BorderColor #5D4037
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #37474F
}

title SmartFinance — llm-local-agent-feature branch (FINA, no Gemini)

' ============================================================
'  Mac host (developer / web + API tier) — Tailscale 100.x.y.z
' ============================================================

node "Mac host\n(Tailscale 100.x.y.z)" as mac_host #E8F5E9 {

  package "Client Browser" {
    [React SPA\n(Vite + TailwindCSS)\nport 5173] as frontend
  }

  package "Bun Runtime" {
    package "Auth Service\nport 4002" as auth_svc {
      [Auth Controller] as auth_ctrl
      [Auth Service] as auth_biz
      [Users Repository] as auth_repo
      [Rate Limiter] as rate_lim
    }

    package "Finance Service (FINA hub)\nport 4001" as fin_svc {
      [Accounts / Categories / Txn / Budgets\nControllers] as crud_ctrl
      [FINA Controller\n/api/fina/*] as fina_ctrl
      [FINA Client\n(httpx → Tailscale)] as fina_client
      [Action Executor\n(LOG / EDIT / DELETE)] as action_exec
      [Services Layer] as fin_biz
      [Repositories Layer] as fin_repo
    }

    package "Insights Service (legacy, unused on this branch)\nport 4003" as ins_svc #ECEFF1 {
      [Chat Controller (legacy)] as chat_ctrl
    }
  }

  package "Docker Compose" {
    database "MySQL Server" as mysql {
      [auth] as auth_db
      [finance] as fin_db
      [insights] as ins_db
    }
    [phpMyAdmin\nport 8080] as pma
  }
}

' ============================================================
'  Windows host (GPU) — Tailscale 100.126.232.108
' ============================================================

node "Windows host (GPU)\nTailscale 100.126.232.108" as win_host #FFF3E0 {

  package "FINA Brain\n(FastAPI api.py)\nport 8105" as fina_brain {
    [FastAPI Router\n/chat /dashboard /logs] as fina_api
    [make_context\n(role-aware)] as fina_ctx
    [RAG Retriever\n(rag.retriever)] as fina_rag
    database "ChromaDB\n(per-user collection)" as chroma
    [LSTM Forecaster] as lstm
    [Qwen2.5-3B + LoRA v8\n(local inference)] as qwen
    [parse_model_output\n(fina_schema)] as fina_parse
    [role_guard\n+ action dispatch] as fina_guard
  }
}

' ============================================================
'  Frontend connections (intra-Mac, localhost / vite proxy)
' ============================================================

frontend --> auth_ctrl   : "HTTP\nlogin / register"
frontend --> crud_ctrl   : "HTTP REST\naccounts/categories/\ntxn/budgets"
frontend --> fina_ctrl   : "HTTP\nPOST /api/fina/chat\nGET  /api/fina/dashboard\nGET  /api/fina/logs\nPATCH /api/fina/logs/:id/feedback"

' ============================================================
'  Auth / Finance internals
' ============================================================

auth_ctrl --> auth_biz
auth_biz  --> auth_repo
auth_repo --> auth_db
auth_ctrl --> rate_lim

crud_ctrl --> fin_biz
fina_ctrl --> fin_biz
fina_ctrl --> fina_client
fina_ctrl --> action_exec
action_exec --> fin_repo
fin_biz   --> fin_repo
fin_repo  --> fin_db
fina_ctrl --> ins_db : "INSERT chat_logs\n(separate pool)"

' ============================================================
'  Cross-host link over Tailscale
' ============================================================

fina_client -[#1565C0,thickness=2]-> fina_api : "HTTPS over Tailscale\nPOST /chat\nGET  /dashboard\nGET  /logs\nFINA_API_URL=\nhttp://100.126.232.108:8105"

fina_api -[#1565C0,thickness=2,dashed]-> fina_ctrl : "Callbacks over Tailscale\nGET  /api/fina/users/:id/summary\nGET  /api/fina/users/:id/transactions\nGET  /api/fina/users/:id/spending/daily\nGET  /api/fina/users/:id/spending/monthly-history\nGET  /api/fina/users/:id/category-budgets\nPOST /api/fina/callbacks/categorized\nPOST /api/fina/callbacks/forecast/:id"

' ============================================================
'  FINA Brain internals (Windows)
' ============================================================

fina_api  --> fina_ctx
fina_api  --> fina_rag
fina_ctx  --> lstm     : "predict(daily) → forecast"
fina_rag  --> chroma   : "upsert + query top-k"
fina_api  --> qwen     : "generate(prompt)"
fina_api  --> fina_parse
fina_api  --> fina_guard

' ============================================================
'  phpMyAdmin
' ============================================================

pma --> mysql

' ============================================================
'  Notes
' ============================================================

note bottom of ins_svc
  Legacy Insights service (TS RAG + Gemini)
  is no longer on the user-facing chat path.
  Frontend now hits Finance /api/fina/chat,
  which proxies to FINA Brain on Windows.
end note

note right of fina_brain
  All AI runs locally:
  • Qwen2.5-3B + LoRA v8 (no Gemini)
  • ChromaDB for per-user RAG
  • LSTM for spending forecast
end note

@enduml
